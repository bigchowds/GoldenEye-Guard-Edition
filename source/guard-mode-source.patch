diff --git a/scripts/guardmode_portrait.py b/scripts/guardmode_portrait.py
new file mode 100644
index 0000000..a979fbc
--- /dev/null
+++ b/scripts/guardmode_portrait.py
@@ -0,0 +1,103 @@
+"""Encode the guard photograph as the retail I4 passport texture quadrants.
+
+Uses GE's own Huffman tree construction and predictive filters. Each quadrant
+retains its original byte allocation, dimensions, format and all seven LODs,
+so the image table, display lists and downstream offsets remain valid.
+"""
+from collections import Counter
+from pathlib import Path
+from PIL import Image
+
+ROOT = Path(__file__).resolve().parents[1]
+SIZES = {'UL': 1407, 'UR': 1533, 'LL': 1226, 'LR': 1547}
+DIMS = [65, 33, 17, 9, 5, 3, 2]
+
+
+def huffman(values):
+    counts = Counter(values)
+    top = max(counts.values())
+    frequencies = [max(1, round(counts[i] * 255 / top)) if counts[i] else 0 for i in range(16)]
+    original = frequencies[:]
+    frequencies += [9999] * (2048 - 16)
+    nodes = [[-1, -1] for _ in range(2048)]
+
+    def smallest():
+        a = b = 9999
+        ia = ib = -1
+        for i, f in enumerate(frequencies):
+            if f < a:
+                if b < a:
+                    a, ia = f, i
+                else:
+                    b, ib = f, i
+            elif f < b:
+                b, ib = f, i
+        return a, b, ia, ib
+
+    while True:
+        a, b, ia, ib = smallest()
+        if a == 9999 or b == 9999:
+            break
+        total = max(1, frequencies[ia] + frequencies[ib])
+        frequencies[ia] = frequencies[ib] = 9999
+        if nodes[ia][0] < 0 and nodes[ia][1] < 0:
+            root = ia
+            nodes[root] = [ia + 10000, ib + 10000 if nodes[ib][0] < 0 and nodes[ib][1] < 0 else ib]
+        elif nodes[ib][0] < 0 and nodes[ib][1] < 0:
+            root = ib
+            nodes[root] = [ib + 10000, ia]
+        else:
+            root = next(i for i, n in enumerate(nodes) if n[0] < 0 and n[1] < 0 and frequencies[i] == 9999)
+            nodes[root] = [ia, ib]
+        frequencies[root] = total
+    codes = {}
+
+    def visit(node, prefix):
+        if node >= 10000:
+            codes[node - 10000] = prefix
+        else:
+            for bit, child in enumerate(nodes[node]):
+                visit(child, prefix + str(bit))
+
+    visit(root, '')
+    return ''.join(f'{f:08b}' for f in original) + ''.join(codes[v] for v in values)
+
+
+def encode_level(image):
+    width, height = image.size
+    # Eight greys fit the smallest retail quadrant while retaining I4 layout.
+    values = [min(7, (v + 18) // 37) * 2 for v in image.transpose(Image.Transpose.FLIP_TOP_BOTTOM).tobytes()]
+    variants = []
+    for method in range(7):
+        residuals = []
+        for y in range(height):
+            for x in range(width):
+                idx = y * width + x
+                left = values[idx - 1] if x else 0
+                above = values[idx - width] if y else 0
+                diagonal = values[idx - width - 1] if x and y else 0
+                predictions = [left, above, diagonal, left + above - diagonal,
+                               left + int((above - diagonal) / 2),
+                               above + int((left - diagonal) / 2), int((left + above) / 2)]
+                residuals.append((values[idx] - predictions[method]) % 16)
+        bits = f'{8:04b}{width:08b}{height:08b}{8:04b}{method:03b}' + huffman(residuals)
+        # Retail advances an extra byte when a level ends on an exact byte.
+        bits += '0' * ((-len(bits) % 8) or 8)
+        variants.append(bytes(int(bits[i:i + 8], 2) for i in range(0, len(bits), 8)))
+    return min(variants, key=len)
+
+
+def main():
+    portrait = Image.open(ROOT / 'assets/guardmode/guard_portrait.png').convert('L').resize((129, 129), Image.Resampling.LANCZOS)
+    for quadrant, (x, y) in zip(SIZES, [(0, 0), (64, 0), (0, 64), (64, 64)]):
+        original = portrait.crop((x, y, x + 65, y + 65))
+        data = bytes([0x87]) + b''.join(encode_level(original.resize((n, n), Image.Resampling.LANCZOS)) for n in DIMS)
+        if len(data) > SIZES[quadrant]:
+            raise ValueError(f'{quadrant}: {len(data)} exceeds retail allocation {SIZES[quadrant]}')
+        path = ROOT / f'assets/images/split/BROSNAN_{quadrant}.bin'
+        path.write_bytes(data.ljust(SIZES[quadrant], b'\0'))
+        print(f'{quadrant}: {len(data)}/{SIZES[quadrant]} bytes, seven I4 LODs')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/scripts/toolchain/gnu-mips-as b/scripts/toolchain/gnu-mips-as
new file mode 100755
index 0000000..8a63f69
--- /dev/null
+++ b/scripts/toolchain/gnu-mips-as
@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+import sys,subprocess,tempfile,re,os
+from pathlib import Path
+args=sys.argv[1:]
+inputs=[(i,a) for i,a in enumerate(args) if a.endswith(('.s','.S')) and Path(a).is_file()]
+out=args[args.index('-o')+1] if '-o' in args else ''
+if inputs and out.startswith('build/u-'):
+ i,name=inputs[-1]
+ profile=out.split('/')[1]
+ with tempfile.NamedTemporaryFile(mode='w',suffix='.s') as t:
+  source=subprocess.check_output(['python3','scripts/toolchain/expand-llvm-incbin-macros.py',name],text=True) if name in ['assets/music/music.s','assets/obseg/ob_seg.s'] else Path(name).read_text()
+  t.write(source.replace('build/u/','build/'+profile+'/'));t.flush();args[i]=t.name
+  sys.exit(subprocess.call(['mips-linux-gnu-as',*args]))
+os.execvp('mips-linux-gnu-as',['mips-linux-gnu-as',*args])
